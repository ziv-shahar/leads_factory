# ============================================================================
# Supabase Storage Import Configuration
# ============================================================================
# Copy this file to .env.storage and fill in your values
# Then run: python3 import_from_supabase_storage.py

# Source Supabase Project (where your files are stored)
SOURCE_SUPABASE_URL=https://xxxxx.supabase.co
SOURCE_SUPABASE_KEY=your-service-role-key-or-anon-key-here

# Storage Bucket Configuration
SOURCE_BUCKET_NAME=your-bucket-name

# NOTE: SOURCE_FOLDER_PATH is automatically set to today's date (YYYY-MM-DD)
# You can override it by uncommenting below or passing as command line argument:
# SOURCE_FOLDER_PATH=2026-01-20
#
# Or run with specific date:
# python3 import_from_supabase_storage.py 2026-01-20
