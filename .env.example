# Database
DATABASE_URL=postgresql://leadgen_user:leadgen_pass@localhost:5432/leadgen_db

# LLM Provider (choose one)
LLM_PROVIDER=mock  # Options: openai, anthropic, mock
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Search Provider (for enrichment)
SEARCH_PROVIDER=mock  # Options: tavily, exa, serpapi, mock
TAVILY_API_KEY=your_tavily_key_here
EXA_API_KEY=your_exa_key_here
SERPAPI_KEY=your_serpapi_key_here

# Enrichment settings
ENRICHMENT_ENABLED=true  # Set to false to skip enrichment entirely (no search needed)
ENRICHMENT_FRESHNESS_DAYS=30

# Scoring settings
SCORING_TIME_DECAY_DAYS=90
