# ============================================================================
# Lead Intelligence Portal - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git (it's in .gitignore)

# ============================================================================
# Supabase Configuration
# ============================================================================

# Your Supabase project URL
# Find this in: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Supabase Anonymous Key (public, safe to expose)
# Find this in: Supabase Dashboard → Settings → API → Project API keys → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (PRIVATE - server-side only, DO NOT EXPOSE)
# Find this in: Supabase Dashboard → Settings → API → Project API keys → service_role
# Only used for admin operations, never exposed to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# Application Configuration
# ============================================================================

# Application URL (for OAuth redirects, email links, etc.)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode
NODE_ENV=development

# ============================================================================
# Authentication Configuration
# ============================================================================

# JWT Secret for session signing (generate a random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Session expiration (in seconds)
# 7 days = 604800 seconds
SESSION_EXPIRATION=604800

# ============================================================================
# Email Configuration (Optional - for transactional emails)
# ============================================================================

# Email provider (resend, sendgrid, or leave empty to use Supabase default)
EMAIL_PROVIDER=

# Resend API Key (if using Resend)
RESEND_API_KEY=

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY=

# From email address
EMAIL_FROM=noreply@yourcompany.com

# ============================================================================
# Analytics & Monitoring (Optional)
# ============================================================================

# Sentry DSN (for error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Vercel Analytics (automatically enabled on Vercel)
# No configuration needed

# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=

# ============================================================================
# Feature Flags (Optional)
# ============================================================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_EXPORT=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# ============================================================================
# API Rate Limiting (Optional)
# ============================================================================

# Rate limit per user (requests per minute)
RATE_LIMIT_RPM=100

# ============================================================================
# Development Tools
# ============================================================================

# Enable verbose logging in development
DEBUG=false

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1
